@echo off
echo Starting PrivaShield AI Services...

echo Starting Frontend...
start cmd /k "title Frontend && cd frontend && npm run dev"

echo Starting FastAPI Backend...
start cmd /k "title FastAPI Backend && cd rag && call .\venv\Scripts\activate && python main.py"

echo Starting Scraper Worker...
start cmd /k "title Scraper Worker && cd rag && call .\venv\Scripts\activate && python -m workers.start_worker"

echo Starting Parser Worker...
start cmd /k "title Parser Worker && cd rag && call .\venv\Scripts\activate && python -u -m workers.parser_worker"

echo Starting Cron Dispatcher...
start cmd /k "title Cron Dispatcher && cd rag && call .\venv\Scripts\activate && python -m workers.cron_worker"

echo All services launched in separate windows!
